# ---------------------------------------------------------------------------
# Environment variable template for the ProductLab AI Product Experimentation.
# Never commit a real .env file.
#
# Backend variables (everything up to the "Frontend" section) are read by
# app.core.config.Settings (backend/app/core/config.py) — copy them to
# backend/.env and adjust as needed.
#
# Frontend variables are read by the Next.js app (frontend/) — copy them to
# frontend/.env.local and adjust as needed.
# ---------------------------------------------------------------------------

# Display name returned by GET /api/v1/health
APP_NAME="ProductLab AI Product Experimentation API"

# Backend application environment: development | test | production
APP_ENV=development

# Enables debug behavior; set to false in production
APP_DEBUG=true

# Prefix under which all API routes are mounted
API_PREFIX=/api/v1

# SQLAlchemy database URL (SQLite for the MVP). Relative paths are resolved
# from the backend/ working directory; the parent directory is created
# automatically if it doesn't exist.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of origins allowed to call the API via CORS. Must
# include the frontend's origin (http://localhost:3000 by default).
CORS_ORIGINS=http://localhost:3000

# Python logging level for the application
LOG_LEVEL=INFO

# OpenAI API key used by the LLM provider abstractions (persona generation,
# variant simulations, Insight generation, and the decision memo). Only
# required for calling those specific endpoints — the application starts,
# and every other route works, with no key configured. Leave unset or as
# the "changeme" placeholder to run the app and its test suite without ever
# calling OpenAI; the frontend surfaces this as a 503 "provider not
# configured" error on the affected actions.
OPENAI_API_KEY=changeme

# OpenAI model identifier used when requesting structured JSON output
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Base URL the Next.js frontend uses to reach the FastAPI backend. Never put
# secrets in NEXT_PUBLIC_ variables — they are exposed to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
